{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "name": "Run Script: start",
      "request": "launch",
      "command": "npm run start",
      "cwd": "${workspaceFolder}/web"
    },
    {
      "type": "node-terminal",
      "name": "Run Script: serve:pwa",
      "request": "launch",
      "command": "npm run serve:pwa",
      "cwd": "${workspaceFolder}/web"
    },
    {
      "type": "node-terminal",
      "name": "Run Script: serve:server",
      "request": "launch",
      "command": "npm run serve:server",
      "cwd": "${workspaceFolder}/web"
    },
    {
      "type": "node-terminal",
      "name": "Run Script: test",
      "request": "launch",
      "command": "npm run test",
      "cwd": "${workspaceFolder}/web"
    },
    {
      "name": "BudganSvr (http)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Server/BudganSvr/bin/Debug/net10.0/BudganSvr.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Server/BudganSvr",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5222"
      }
    },
    {
      "name": "compose.yaml.budgansvr",
      "type": "coreclr",
      "request": "attach",
      "preLaunchTask": "compose-up",
      "processId": "${command:pickProcess}",
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeArgs": ["exec", "-i", "budgansvr-budgansvr-1"],
        "debuggerPath": "/vsdbg/vsdbg",
        "pipeCwd": "${workspaceFolder}/Server"
      },
      "sourceFileMap": {
        "/src/BudganSvr": "${workspaceFolder}/Server/BudganSvr"
      }
    },
    {
      "name": "Docker: Attach to BudganSvr",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeArgs": ["exec", "-i", "budgansvr-budgansvr-1"],
        "debuggerPath": "/vsdbg/vsdbg",
        "pipeCwd": "${workspaceFolder}/Server"
      },
      "sourceFileMap": {
        "/src/BudganSvr": "${workspaceFolder}/Server/BudganSvr"
      }
    }
  ]
}
